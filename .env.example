# ──── Environment ────
SECRET_KEY=change-me-in-production
FLASK_DEBUG=True

# ──── Chunking ────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ──── Embedding Model ────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ──── LLM API (Default: Qwen via DashScope) ────
LLM_API_KEY=your_qwen_api_key_here
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
